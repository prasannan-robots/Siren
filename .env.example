# Copy to .env (in the repo root) and fill in. Never commit .env.

# Roboflow (traffic-light / stop-sign / right-turn models)
ROBOFLOW_API_KEY=

# Google Maps Platform (geocoding + distance)
GOOGLE_MAPS_API_KEY=

# GPS (NEO-6M over serial); defaults shown
GPS_PORT=/dev/ttyUSB0
GPS_BAUDRATE=9600

# MQTT broker for publishing violations (e.g. HiveMQ Cloud). Leave MQTT_BROKER
# empty to log violations locally only. Port 8883 enables TLS.
MQTT_BROKER=
MQTT_PORT=8883
MQTT_USERNAME=
MQTT_PASSWORD=
